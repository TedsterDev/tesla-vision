[Unit]
Description=TeslaCam ingest - copies finished clips from the car's volume into the inbox
Documentation=file:/home/tedster/projects/tesla-alerts/README.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
# Root, for the same two reasons the other host units are: /mnt/teslacam is a
# root-mounted volume, and the inbox must be writable by the root-owned
# processor container that consumes it. The gate this service enforces reads
# configfs, which is the other thing a container should never be shown.
User=root
WorkingDirectory=/home/tedster/projects/tesla-alerts
EnvironmentFile=-/home/tedster/projects/tesla-alerts/.env
Environment=PYTHONPATH=/home/tedster/projects/tesla-alerts
Environment=BASE_DIR=/mnt/jetsondata/tesla-alerts
Environment=TESLACAM_DIR=/mnt/teslacam/TeslaCam
ExecStart=/usr/bin/python3 -u /home/tedster/projects/tesla-alerts/src/ingest.py

Restart=always
RestartSec=15

# Sandboxed like gps.service, not like natix-mirror: this mounts nothing, it
# only reads a mount somebody else made. ReadWritePaths is the inbox's parent.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/mnt/jetsondata/tesla-alerts
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
