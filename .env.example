# Dashboard HTTP Basic auth. Leave DASHBOARD_PASS empty to disable auth.
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Tesla Fleet API (optional) --------------------------------------------
# Enables GPS/drive context on every detection, which is what lets the
# correlation engine tell a neighbour from a follower. Everything still runs
# without these, just with weaker signals.
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_VIN=
# Regional Fleet API host. Default is North America.
# Europe: https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com

# --- GNSS receiver (src/gps.py) ---------------------------------------------
# A USB u-blox receiver on the Jetson, as an alternative to the Tesla Fleet API
# above. Needs no credentials, cannot be deprecated out from under us, doesn't
# keep the car awake, and works with no connectivity. It cannot report odometer,
# charge state or shift position - none of which correlate.py scores on.
#
# Use the by-id path, not /dev/ttyACM0: ttyACM numbering is enumeration order,
# so it changes the moment anything else that speaks CDC-ACM is plugged in.
GPS_DEVICE=/dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_GNSS_receiver-if00

# How often to record a position. The receiver emits at 1Hz; we don't need
# every sample. At 5s a car at 70mph moves ~150m between rows, which is finer
# than any question correlate.py asks.
GPS_MOVING_SAMPLE_SECONDS=5
GPS_PARKED_SAMPLE_SECONDS=300

# Reverse geocoding is gated on distance travelled, not on sample count.
# geo.py caches at ~11m, so geocoding per sample would be a fresh Nominatim
# request every time at road speed - hundreds per drive, which is how you get
# your IP banned from OSM's free endpoint.
GPS_GEOCODE_MIN_MOVE_MILES=0.25

# How often gps.py republishes logs/gps.json, the heartbeat /gps reads. This is
# the ONLY way the dashboard can tell a car parked under cover from a crashed
# service: both write nothing to the polls table. At 5s that is ~17k atomic
# rewrites a day on the SD card, which is fine; 1Hz is not.
GPS_HEARTBEAT_SECONDS=5

# --- Clip timestamps ---------------------------------------------------------
# Tesla names clips in the CAR's local time. This is the zone they are parsed
# in - never the process's own, which in a container is UTC. Getting this wrong
# places every detection where the car was hours earlier. IANA name.
CLIP_TIMEZONE=America/Los_Angeles

# --- TeslaCam ingest (host service, scripts/install_ingest.sh) ---------------
# How often to look for finished clips on /mnt/teslacam, in seconds. The
# service only reads the volume while it is mounted AND not exported to the car.
INGEST_POLL_SECONDS=30

# --- Notifications (optional) ----------------------------------------------
# Any one of these enables push alerts for high-severity findings.
NTFY_TOPIC=
ALERT_WEBHOOK_URL=
PUSHOVER_TOKEN=
PUSHOVER_USER=
NOTIFY_MIN_SEVERITY=high

# --- Pipeline stage switches -----------------------------------------------
ENABLE_ALPR=true
ENABLE_FACES=true
ENABLE_CORRELATION=true
ENABLE_NOTIFICATIONS=true

# Per-clip frame budgets for the expensive stages. Raise these if you move to
# a GPU-enabled (L4T) base image.
ALPR_MAX_FRAMES=8
FACE_MAX_FRAMES=8

# How many frames to analyse per clip, spread evenly across the WHOLE clip.
# (This replaced an older SAMPLE_FPS setting. If you have SAMPLE_FPS in your
# .env, delete it - nothing reads it any more.)
SAMPLE_FRAMES_PER_CLIP=30

# Cap the analysed window in seconds. 0 = the whole clip, which is what you
# want. Any NON-ZERO value front-loads sampling into the first N seconds of a
# 60-second clip and silently stops the detector from ever seeing the rest -
# the clearest plate in our sample footage sits 26 seconds in, which a value of
# 10 here would never look at. Leave this at 0 unless you know why you are not.
SAMPLE_MAX_SECONDS=0

# --- GIF previews -----------------------------------------------------------
# Dashboard thumbnails, not archival footage - the source mp4 is still on disk.
GIF_SECONDS=5
GIF_FPS=8
GIF_SCALE_WIDTH=480

# --- NATIX VX360 ------------------------------------------------------------
# The VX360 is a USB stick with an ARM SoC inside that uploads TeslaCam footage
# to NATIX's cloud over WiFi. In this build the car writes to the Jetson, not
# to the stick, so a host service (scripts/install_natix.sh) mirrors clips onto
# it in Tesla's own directory layout. See README "Feeding the NATIX VX360".

# Where the stick gets mounted. Must stay inside the allowlist that
# scripts/natix_mount.sh enforces (/mnt/natixv360, /mnt/natix, /media/natix).
NATIX_MOUNTPOINT=/mnt/natixv360

# How sure we must be before writing gigabytes to a device.
#   pinned - an explicit NATIX_VOLUME_UUID / NATIX_SERIAL / NATIX_USB_ID matched
#   strong - the volume label or an on-disk marker says NATIX or VX360
#   likely - it is merely a removable USB volume of about the right size
# 'strong' is the right default: the retail stick labels its volume VX360, and
# anything less specific is not worth the risk of filling a stranger's drive.
NATIX_MIN_CONFIDENCE=strong

# Pin the exact stick once you have run scripts/natix_probe.py.
# NOTE: prefer NATIX_VOLUME_UUID. The VX360 runs Linux and exports its flash
# with the kernel's file-backed storage gadget, so its USB id (0525:a4a5) and
# serial ("Linux_File-Stor_Gadget-0:0") are the stock gadget values shared by
# every Linux storage gadget - including this Jetson when it presents itself to
# the car. natix.py ignores those two as identities for exactly that reason.
# NATIX_VOLUME_UUID=FFFB-6B2F
# NATIX_SERIAL=
# NATIX_USB_ID=

# Substrings accepted in a volume label / model / vendor string.
NATIX_NAME_PATTERNS=natix,vx360,vx-360,vx_360

# Files that identify the stick once it is mounted.
NATIX_MARKER_PATHS=.natix,natix.json,.vx360,NATIX,.natix_device

# Shape matching, used only when nothing above hit. The retail stick exposes a
# ~35GB LUN out of its 128-256GB of flash, keeping the rest for its own OS and
# upload spool - so the floor is well below the advertised capacity.
NATIX_MIN_SIZE_GB=16
NATIX_MAX_SIZE_GB=2048

# Leave this much free so the stick's own firmware has room to work.
NATIX_RESERVE_MB=2048

# TeslaCam bucket we file clips under when the clip row doesn't say.
NATIX_DEFAULT_BUCKET=SentryClips

# Synthesise Tesla's event.json in each event folder when one is absent.
NATIX_WRITE_EVENT_JSON=1

# Unmount after each pass. Safer in a car, where power vanishes without notice.
NATIX_UNMOUNT_AFTER=1

# Mirror pacing: seconds between passes, and clips per pass.
NATIX_POLL_SECONDS=60
NATIX_BATCH=24

# Buckets the mirror may reclaim space from when the stick arrives full of
# footage we did not write. EMPTY BY DEFAULT - it deletes the owner's clips.
#
# You will need this on a stick that has been in a car. The VX360 loop-deletes
# only while the *car* is writing to it; here the car writes to the Jetson, so
# the stick's own loop never runs again and it stays permanently full. Taking
# over the loop is the only way the arrangement works.
#
# Leave SavedClips out: those are the clips somebody pressed the button to keep.
# Run `natix_probe.py --tree` first to see what is actually on the stick.
# NATIX_RECLAIM_BUCKETS=SentryClips,RecentClips

# Copy until the filesystem itself says ENOSPC, instead of trusting the mount's
# free-space figure. Needed when relan's exfat-fuse (which mounts the stick)
# and exfatprogs' fsck (which checks it) disagree about allocation - fsck says
# "clean" while the mount claims 99% full, and the pre-check then blocks every
# copy forever for a condition that does not exist. Safe: a real ENOSPC is
# already handled atomically. Confirm with: sudo ./scripts/natix_fsck.sh --write-test
# NATIX_IGNORE_FREE_SPACE=1

# --- Cloudflare Access ------------------------------------------------------
# Only needed if the dashboard is published through a Cloudflare tunnel with
# Access in front. Access CONSUMES the Authorization header, so HTTP Basic can
# never succeed on that path - the browser prompts, the header is stripped, the
# origin 401s, and it prompts again forever. We verify Access's signed JWT
# instead. Leave unset and only Basic Auth applies.
#
# Both values are required before any token is accepted; the AUD tag pins the
# check to THIS application so a token minted for another app in the same
# Cloudflare team is not honoured here.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<Zero Trust > Access > Applications > your app > AUD tag>
# CF_ACCESS_ALLOWED_EMAILS=you@example.com
